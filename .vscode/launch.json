{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Edge: GitHub with extension",
      "type": "msedge",
      "request": "launch",
      "url": "https://github.com",
      "preLaunchTask": "build:dev",
      "runtimeArgs": [
        "--disable-extensions-except=${workspaceFolder}/dist",
        "--load-extension=${workspaceFolder}/dist"
      ],
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    }
  ]
}
